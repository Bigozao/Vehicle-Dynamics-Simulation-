# =========================================================
# Figura-8 (referência)
# =========================================================
R_figure8 = 20.0
n_per_circle = 1600

def build_figure8_waypoints(R=15.0, n_per_circle=1400):
    th1 = np.linspace(0.0, 2*np.pi, n_per_circle, endpoint=False)
    x1 = R * np.sin(th1)
    y1 = -R + R * np.cos(th1)

    phi = np.linspace(np.pi, -np.pi, n_per_circle, endpoint=False)
    x2 = R * np.sin(phi)
    y2 = +R + R * np.cos(phi)

    x_ref = np.concatenate([x1, x2])
    y_ref = np.concatenate([y1, y2])
    return x_ref, y_ref

x_ref, y_ref = build_figure8_waypoints(R_figure8, n_per_circle=n_per_circle)
Nref = len(x_ref)
idx_split = n_per_circle

x_bot = x_ref[:idx_split].copy()
y_bot = y_ref[:idx_split].copy()
x_top = x_ref[idx_split:].copy()
y_top = y_ref[idx_split:].copy()
N_bot = len(x_bot)
N_top = len(x_top)

dx_bot = np.diff(x_bot, append=x_bot[0])
dy_bot = np.diff(y_bot, append=y_bot[0])
ds_bot = np.hypot(dx_bot, dy_bot)
s_bot = np.concatenate([[0.0], np.cumsum(ds_bot[:-1])])
len_bot = float(np.sum(ds_bot))

dx_top = np.diff(x_top, append=x_top[0])
dy_top = np.diff(y_top, append=y_top[0])
ds_top = np.hypot(dx_top, dy_top)
s_top = np.concatenate([[0.0], np.cumsum(ds_top[:-1])])
len_top = float(np.sum(ds_top))

def wrap_pi(a_):
    return (a_ + np.pi) % (2*np.pi) - np.pi

def advance_index_by_distance_branch(idx_ref, dist):
    if dist <= 0:
        return idx_ref

    if idx_ref < idx_split:
        i0 = idx_ref
        st = (s_bot[i0] + dist) % len_bot
        iloc = int(np.argmin(np.abs(s_bot - st)))
        return iloc
    else:
        i0 = idx_ref - idx_split
        st = (s_top[i0] + dist) % len_top
        iloc = int(np.argmin(np.abs(s_top - st)))
        return idx_split + iloc

psi_bot = np.arctan2(np.roll(y_bot, -1) - y_bot, np.roll(x_bot, -1) - x_bot)
psi_top = np.arctan2(np.roll(y_top, -1) - y_top, np.roll(x_top, -1) - x_top)
psi_ref_path = np.concatenate([psi_bot, psi_top])

# =========================================================
# Pneus
# =========================================================
def pacejka_lateral(alpha, Fz, mu, C, E, C_alpha):
    D = mu * Fz
    if D < 1e-3:
        return 0.0
    B = C_alpha / (C * D)
    return D * np.sin(C * np.arctan(B*alpha - E*(B*alpha - np.arctan(B*alpha))))

# =========================================================
# Helpers
# =========================================================
def update_idx_ref_branch_cost(idx_ref, x, y, yaw,
                               search_fwd=450, search_back=120,
                               w_dist=1.0, w_head=14.0,
                               allow_switch_dist=3.5, e_ct_now=0.0):
    allow_switch = (np.hypot(x, y) < allow_switch_dist)

    if allow_switch:
        offsets = np.arange(-search_back, search_fwd)
        idxs = (idx_ref + offsets) % Nref
    else:
        if idx_ref < idx_split:
            i0 = idx_ref
            offs = np.arange(-search_back, search_fwd) if (e_ct_now > 3.0) else np.arange(0, search_fwd)
            idxs_local = (i0 + offs) % N_bot
            idxs = idxs_local
        else:
            i0 = idx_ref - idx_split
            offs = np.arange(-search_back, search_fwd) if (e_ct_now > 3.0) else np.arange(0, search_fwd)
            idxs_local = (i0 + offs) % N_top
            idxs = idx_split + idxs_local

    dx = x_ref[idxs] - x
    dy = y_ref[idxs] - y
    dist2 = dx*dx + dy*dy
    dpsi = wrap_pi(psi_ref_path[idxs] - yaw)
    cost = w_dist * dist2 + w_head * (dpsi*dpsi)
    return int(idxs[int(np.argmin(cost))])

def pick_lookahead_robusto(idx_ref, x, y, yaw, Ld, idx_look_prev,
                           x_b_min_ok=0.5,
                           candidates=(1.0, 1.2, 1.5, 1.8, 2.2, 2.8)):
    best = None
    for mult in candidates:
        idx = advance_index_by_distance_branch(idx_ref, mult * Ld)
        dx, dy = x_ref[idx] - x, y_ref[idx] - y
        x_b =  np.cos(yaw)*dx + np.sin(yaw)*dy
        y_b = -np.sin(yaw)*dx + np.cos(yaw)*dy

        if best is None or x_b > best[1]:
            best = (idx, x_b, y_b)

        if x_b > x_b_min_ok:
            return idx, x_b, y_b, True

    idx, x_b, y_b = best
    if x_b <= 0.0:
        return idx_ref, x_b, 0.0, False
    return idx, x_b, y_b, False

# =========================================================
# Sampling (Monte Carlo)
# =========================================================
def sample_trunc_normal(rng, mean, std, lo, hi, size=None):
    if size is None:
        while True:
            x = rng.normal(mean, std)
            if lo <= x <= hi:
                return x
    out = np.empty(size, dtype=float)
    filled = 0
    while filled < size:
        x = rng.normal(mean, std, size=size)
        ok = (x >= lo) & (x <= hi)
        n_ok = int(np.sum(ok))
        if n_ok > 0:
            take = min(n_ok, size - filled)
            out[filled:filled+take] = x[ok][:take]
            filled += take
    return out

def sample_params_one(rng):
    def draw(spec):
        kind = spec[0]
        if kind == "fixed":
            return float(spec[1])
        if kind == "normal":
            _, mu_, sig_ = spec
            return float(rng.normal(mu_, sig_))
        if kind == "uniform":
            _, lo, hi = spec
            return float(rng.uniform(lo, hi))
        if kind == "triangular":
            _, lo, mode, hi = spec
            return float(rng.triangular(lo, mode, hi))
        if kind == "normal_trunc_pos":
            _, mu_, sig_ = spec
            return float(sample_trunc_normal(rng, mu_, sig_, 1e-12, np.inf))
        if kind == "normal_trunc":
            _, mu_, sig_, lo, hi = spec
            return float(sample_trunc_normal(rng, mu_, sig_, lo, hi))
        raise ValueError(f"Distribuição desconhecida: {kind}")

    m  = draw(UNC["m"])
    Iz = draw(UNC["Iz"])
    a  = draw(UNC["a"])
    b  = draw(UNC["b"])
    d_frente = draw(UNC["d_frente"])
    d_tras   = draw(UNC["d_tras"])
    h_CG     = draw(UNC["h_CG"])

    mu = draw(UNC["mu"])
    C_pacejka = draw(UNC["C_pacejka"])
    E_pacejka = draw(UNC["E_pacejka"])

    # C_alpha correlacionado (lognormal)
    C_nom = float(UNC["C_alpha_nom"])
    cv    = float(UNC["C_alpha_cv"])
    rho   = float(UNC["C_alpha_rho"])

    sigma_ln = np.sqrt(np.log(1 + cv**2))
    mu_ln    = np.log(C_nom) - 0.5*sigma_ln**2

    z1 = rng.standard_normal()
    z2 = rho*z1 + np.sqrt(max(1.0 - rho*rho, 0.0))*rng.standard_normal()

    C_alpha_front = float(np.exp(mu_ln + sigma_ln*z1))
    C_alpha_rear  = float(np.exp(mu_ln + sigma_ln*z2))

    return {
        "m": m, "Iz": Iz, "a": a, "b": b,
        "d_frente": d_frente, "d_tras": d_tras,
        "h_CG": h_CG,
        "C_alpha_front": C_alpha_front,
        "C_alpha_rear": C_alpha_rear,
        "mu": mu,
        "C_pacejka": C_pacejka,
        "E_pacejka": E_pacejka,
    }

