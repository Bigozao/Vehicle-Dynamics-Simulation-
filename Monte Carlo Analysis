# =========================================================
# Simulação
# =========================================================
def simulate_once(params, dt=0.001, t_total=60.0, do_log=False, verbose_every=0, gate_r=3.5, marker_tol=40):
    m  = float(params["m"])
    Iz = float(params["Iz"])
    a  = float(params["a"])
    b  = float(params["b"])
    L  = a + b
    d_frente = float(params["d_frente"])
    d_tras   = float(params["d_tras"])
    h_CG     = float(params["h_CG"])

    C_alpha_front = float(params["C_alpha_front"])
    C_alpha_rear  = float(params["C_alpha_rear"])
    mu = float(params["mu"])
    C_pacejka = float(params["C_pacejka"])
    E_pacejka = float(params["E_pacejka"])

    # limites / controlos
    delta_max_rad = np.deg2rad(25.0)
    tau_steer = 0.03
    use_delta_rate_limit = True
    delta_rate_max = np.deg2rad(600.0)

    vx_target_nom = 12.0
    Kp_vx = 1.2
    ax_lim_pos = 5.0
    ax_lim_neg = 7.0

    Ld0 = 3.0
    Ld_gain = 0.80
    alpha_max = np.deg2rad(50.0)

    ay_margin = 0.90
    ay_max_base = ay_margin * mu * g

    vx_target_f = vx_target_nom
    tau_v = 0.40

    k_fb = 0.80
    k_psi = 1.10
    k_w  = 0.35
    dkappa_w_max = 0.35
    kappa_abs_nom = 1.0 / R_figure8

    e_ct_recover = 8.0
    vx_recover   = 2.0
    x_b_min_ok   = 0.5

    # distribuição estática por eixo
    Wf = (b / L) * m * g
    Wr = (a / L) * m * g
    frac_f = Wf / (Wf + Wr)
    frac_r = Wr / (Wf + Wr)

    # estados iniciais
    x, y = 0.0, 0.0
    vx, vy = 0.1, 0.0
    yaw, w = 0.0, 0.0
    ax = 0.0
    delta = 0.0

    ay_for_load = 0.0
    idx_ref = int(np.argmin((x_ref-x)**2 + (y_ref-y)**2))
    idx_look_prev = idx_ref

    # contadores antigos (mantidos)
    time_bottom = 0.0
    time_top    = 0.0
    time_gate   = 0.0

    # logs opcionais
    if do_log:
        traj_x, traj_y = [], []
        vx_list, vy_list, ax_list = [], [], []
        yaw_list, w_list = [], []
        delta_list = []
        e_ct_list = []

    # métricas
    e_ct_max = 0.0
    e_ct_rms_acc = 0.0
    e_ct_rms_n = 0
    n_fail = 0
    n_recover = 0

    # tempo Figure-8
    started = False
    completed = False
    t_start = 0.0
    time_figure8 = float("nan")

    bottom_marker_idx = int(idx_split // 2)
    top_marker_idx    = int(idx_split + (idx_split // 2))
    hit_bottom = False
    hit_top = False

    in_gate_prev = (np.hypot(x, y) < gate_r)

    n_steps = int(np.floor(t_total / dt))
    for i in range(n_steps):
        tt = i * dt

        if not np.isfinite(x) or not np.isfinite(y) or abs(x) > 1e4 or abs(y) > 1e4:
            n_fail = 1
            break

        e_ct_now = float(np.hypot(x_ref[idx_ref] - x, y_ref[idx_ref] - y))
        idx_ref = update_idx_ref_branch_cost(idx_ref, x, y, yaw, e_ct_now=e_ct_now, allow_switch_dist=gate_r)
        e_ct = float(np.hypot(x_ref[idx_ref] - x, y_ref[idx_ref] - y))

        e_ct_max = max(e_ct_max, e_ct)
        e_ct_rms_acc += e_ct*e_ct
        e_ct_rms_n += 1

        # tempo sem gate (contadores antigos)
        in_gate = (np.hypot(x, y) < gate_r)
        if in_gate:
            time_gate += dt
        else:
            if idx_ref < idx_split:
                time_bottom += dt
            else:
                time_top += dt

        # completamento Figure-8
        if (not started) and in_gate_prev and (not in_gate):
            started = True
            t_start = tt
            hit_bottom = False
            hit_top = False

        if started and (not in_gate):
            if (idx_ref < idx_split) and (abs(idx_ref - bottom_marker_idx) <= marker_tol):
                hit_bottom = True
            if (idx_ref >= idx_split) and (abs(idx_ref - top_marker_idx) <= marker_tol):
                hit_top = True

        if started and (not in_gate_prev) and in_gate and hit_bottom and hit_top:
            completed = True
            time_figure8 = tt - t_start
            break

        in_gate_prev = in_gate

        # speed planning
        ay_cap = np.sqrt(max(ay_max_base*ay_max_base - ax*ax, 0.0))
        v_lim_path = np.sqrt(ay_cap / (kappa_abs_nom + 1e-6))

        if e_ct > 1.0:  v_lim_path *= 0.90
        if e_ct > 2.0:  v_lim_path *= 0.80
        if e_ct > 3.0:  v_lim_path *= 0.65
        if e_ct > 5.0:  v_lim_path *= 0.45
        if e_ct > 10.0: v_lim_path *= 0.25
        if e_ct > 20.0: v_lim_path *= 0.12

        vx_target_dyn = min(vx_target_nom, v_lim_path)

        if e_ct > e_ct_recover:
            vx_target_dyn = min(vx_target_dyn, vx_recover)
            n_recover += 1

        vx_target_f += (vx_target_dyn - vx_target_f) * (dt / tau_v)
        vx_target_dyn = vx_target_f

        # longitudinal
        erro_vx = vx_target_dyn - vx
        ax_cmd = Kp_vx * erro_vx
        ax = float(np.clip(ax_cmd, -ax_lim_neg, ax_lim_pos))
        vx += ax * dt

        # lookahead
        Ld = max(Ld0 + Ld_gain * vx, 2.5)
        idx_look, x_b, y_b, ok = pick_lookahead_robusto(idx_ref, x, y, yaw, Ld, idx_look_prev, x_b_min_ok=x_b_min_ok)
        if ok:
            idx_look_prev = idx_look

        denom = max(Ld*Ld, 1e-6)
        kappa_pp = 2.0 * y_b / denom
        kappa_ff = (-1.0 / R_figure8) if (idx_ref < idx_split) else (+1.0 / R_figure8)

        psi_ref = float(psi_ref_path[idx_ref])
        e_psi = wrap_pi(psi_ref - yaw)
        kappa_psi = k_psi * np.tan(e_psi) / max(vx, 2.0)

        kappa_cmd = kappa_ff + k_fb * kappa_pp + kappa_psi

        w_ref = vx * kappa_cmd
        dkappa_w = k_w * (w_ref - w) / max(vx, 2.0)
        dkappa_w = float(np.clip(dkappa_w, -dkappa_w_max, dkappa_w_max))
        kappa_cmd += dkappa_w

        kappa_lim = ay_cap / max(vx*vx, 2.0*2.0)
        kappa_cmd = float(np.clip(kappa_cmd, -kappa_lim, kappa_lim))

        delta_ref = np.arctan(L * kappa_cmd)
        delta_ref = float(np.clip(delta_ref, -delta_max_rad, delta_max_rad))

        # actuador
        delta_dot = (delta_ref - delta) / tau_steer
        if use_delta_rate_limit:
            delta_dot = np.clip(delta_dot, -delta_rate_max, delta_rate_max)
        delta += float(delta_dot * dt)
        delta = float(np.clip(delta, -delta_max_rad, delta_max_rad))

        # Ackermann
        if abs(delta) > 1e-6:
            R_geom = L / np.tan(delta)
            delta_FL = np.arctan(L / (R_geom - np.sign(delta) * d_frente/2))
            delta_FR = np.arctan(L / (R_geom + np.sign(delta) * d_frente/2))
        else:
            delta_FL = 0.0
            delta_FR = 0.0

        # slip angles
        alpha_FL = delta_FL - np.arctan2(vy + a*w, vx - w*d_frente/2)
        alpha_FR = delta_FR - np.arctan2(vy + a*w, vx + w*d_frente/2)
        alpha_RL = -np.arctan2(vy - b*w, vx - w*d_tras/2)
        alpha_RR = -np.arctan2(vy - b*w, vx + w*d_tras/2)

        alpha_FL = np.clip(alpha_FL, -alpha_max, alpha_max)
        alpha_FR = np.clip(alpha_FR, -alpha_max, alpha_max)
        alpha_RL = np.clip(alpha_RL, -alpha_max, alpha_max)
        alpha_RR = np.clip(alpha_RR, -alpha_max, alpha_max)

        # cargas verticais
        Fz_FL_static = (b / L) * m * g / 2.0
        Fz_FR_static = (b / L) * m * g / 2.0
        Fz_RL_static = (a / L) * m * g / 2.0
        Fz_RR_static = (a / L) * m * g / 2.0

        deltaFz_long = (h_CG / L) * m * ax
        deltaFz_lat_front = frac_f * (m * ay_for_load * h_CG) / d_frente
        deltaFz_lat_rear  = frac_r * (m * ay_for_load * h_CG) / d_tras

        Fz_FL = Fz_FL_static - deltaFz_long/2.0 - deltaFz_lat_front/2.0
        Fz_FR = Fz_FR_static - deltaFz_long/2.0 + deltaFz_lat_front/2.0
        Fz_RL = Fz_RL_static + deltaFz_long/2.0 - deltaFz_lat_rear/2.0
        Fz_RR = Fz_RR_static + deltaFz_long/2.0 + deltaFz_lat_rear/2.0

        Fz_FL = max(Fz_FL, 0.0)
        Fz_FR = max(Fz_FR, 0.0)
        Fz_RL = max(Fz_RL, 0.0)
        Fz_RR = max(Fz_RR, 0.0)

        # forças laterais
        FyFL = pacejka_lateral(alpha_FL, Fz_FL, mu, C_pacejka, E_pacejka, C_alpha_front)
        FyFR = pacejka_lateral(alpha_FR, Fz_FR, mu, C_pacejka, E_pacejka, C_alpha_front)
        FyRL = pacejka_lateral(alpha_RL, Fz_RL, mu, C_pacejka, E_pacejka, C_alpha_rear)
        FyRR = pacejka_lateral(alpha_RR, Fz_RR, mu, C_pacejka, E_pacejka, C_alpha_rear)

        Fy_total = FyFL + FyFR + FyRL + FyRR

        # dinâmica
        dot_vy = Fy_total / m - vx * w
        vy += dot_vy * dt

        dot_w = (
            a * (FyFL + FyFR)
            - b * (FyRL + FyRR)
            + (d_frente/2.0) * (FyFR - FyFL)
            + (d_tras/2.0)   * (FyRR - FyRL)
        ) / Iz

        w += dot_w * dt
        yaw += w * dt
        yaw = wrap_pi(yaw)

        # posição
        x += (vx * np.cos(yaw) - vy * np.sin(yaw)) * dt
        y += (vx * np.sin(yaw) + vy * np.cos(yaw)) * dt

        ay_for_load = Fy_total / m

        if verbose_every and (i % verbose_every == 0):
            print(f"t={tt:.1f}s | vx={vx:.2f} | e_ct={e_ct:.2f} | mu={mu:.3f}")

        if do_log:
            traj_x.append(x); traj_y.append(y)
            vx_list.append(vx); vy_list.append(vy); ax_list.append(ax)
            yaw_list.append(yaw); w_list.append(w)
            delta_list.append(np.rad2deg(delta))
            e_ct_list.append(e_ct)

    e_ct_rms = float(np.sqrt(e_ct_rms_acc / max(e_ct_rms_n, 1)))

    # fail inclui timeout (não completou)
    fail = int(n_fail or (not completed))

    metrics = {
        "fail": int(fail),
        "time_bottom": float(time_bottom),
        "time_top": float(time_top),
        "time_gate": float(time_gate),
        "time_total_nogate": float(time_bottom + time_top),

        "completed": int(completed),
        "time_figure8": float(time_figure8) if np.isfinite(time_figure8) else float("nan"),

        "e_ct_max": float(e_ct_max),
        "e_ct_rms": float(e_ct_rms),
        "recover_frac": float(n_recover / max(n_steps, 1)),

        # parâmetros para análise
        "mu": float(mu),
        "h_CG": float(h_CG),
        "Caf": float(C_alpha_front),
        "Car": float(C_alpha_rear),
        "Iz": float(Iz),
        "m": float(m),

        # extras
        "a": float(a),
        "b": float(b),
        "d_frente": float(d_frente),
        "d_tras": float(d_tras),
        "C_pacejka": float(C_pacejka),
        "E_pacejka": float(E_pacejka),
    }

    logs = None
    if do_log:
        logs = {
            "traj_x": np.array(traj_x),
            "traj_y": np.array(traj_y),
            "vx": np.array(vx_list),
            "vy": np.array(vy_list),
            "ax": np.array(ax_list),
            "yaw": np.array(yaw_list),
            "w": np.array(w_list),
            "delta_deg": np.array(delta_list),
            "e_ct": np.array(e_ct_list),
            "t": np.arange(0.0, len(traj_x)*dt, dt),
        }

    return metrics, logs

