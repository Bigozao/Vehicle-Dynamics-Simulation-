    ok_idx = [i for i, r in enumerate(results) if (r["fail"] == 0 and r["completed"] == 1)]
    fail_idx = [i for i, r in enumerate(results) if not (r["fail"] == 0 and r["completed"] == 1)]

    print("\n================= MONTE CARLO =================")
    print(f"Runs: {len(results)} | OK (completou 1 Figure-8): {len(ok_idx)} | FAIL (numérico/timeout): {len(fail_idx)}")
    if len(ok_idx) == 0:
