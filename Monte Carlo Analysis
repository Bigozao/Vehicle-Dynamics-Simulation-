        "Iz": np.array([results[i]["Iz"] for i in ok_idx]),
        "h_CG": np.array([results[i]["h_CG"] for i in ok_idx]),
        "Caf": np.array([results[i]["Caf"] for i in ok_idx]),
        "Car": np.array([results[i]["Car"] for i in ok_idx]),
