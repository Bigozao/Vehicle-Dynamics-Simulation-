# Utilitários de análise
# =========================================================
def summarize_percentiles(arr, name):
    arr = np.asarray(arr, dtype=float)
    arr = arr[np.isfinite(arr)]
    if arr.size == 0:
        print(f"{name}: (sem dados finitos)")
        return
    q = np.percentile(arr, [2.5, 10, 50, 90, 97.5])
    print(f"{name}:  P2.5={q[0]:.3f} | P10={q[1]:.3f} | P50={q[2]:.3f} | P90={q[3]:.3f} | P97.5={q[4]:.3f}")

def corr(x, y):
    x = np.asarray(x, dtype=float); y = np.asarray(y, dtype=float)
    if x.size < 3 or y.size < 3:
        return 0.0
    if np.std(x) < 1e-12 or np.std(y) < 1e-12:
        return 0.0
    return float(np.corrcoef(x, y)[0, 1])  # Pearson

def print_fail_stats(emax, thresholds, label="e_ct_max"):
    n = len(emax)
    print("\n--- Probabilidade de falha (por limiar) ---")
    for th in thresholds:
        k = int(np.sum(emax > th))
        p = k / max(n, 1)
        se = np.sqrt(max(p*(1-p)/max(n,1), 0.0))
        print(f"{label} > {th:.1f} m : {k}/{n} = {100*p:.1f}%  (±~{100*1.96*se:.1f} pp)")

def scatter_ok_fail(x, y, fail_mask, xlabel, ylabel, title):
    x = np.asarray(x); y = np.asarray(y); fail_mask = np.asarray(fail_mask, dtype=bool)
    plt.figure(figsize=(8.5, 5.2))
    plt.scatter(x[~fail_mask], y[~fail_mask], s=20, alpha=SCATTER_ALPHA_OK, label="OK")
    plt.scatter(x[fail_mask],  y[fail_mask],  s=28, alpha=SCATTER_ALPHA_FAIL, label="FALHA")
    plt.grid(True)
    plt.xlabel(xlabel); plt.ylabel(ylabel)
    plt.title(title)
    plt.legend()
    plt.tight_layout()
    plt.show()

def print_top_influences(y, yname, params_dict, topk=10):
    y = np.asarray(y, dtype=float)
    items = []
    for k, x in params_dict.items():
        x = np.asarray(x, dtype=float)
        r = corr(x, y)
        items.append((k, abs(r), r))
    items.sort(key=lambda t: t[1], reverse=True)
    print(f"\nTop influências (|corr| vs {yname}):")
    for k, ar, r in items[:topk]:
        print(f"    {k}: {ar:.3f}  (r={r:+.3f})")

def filter_params(params_dict, mask):
    mask = np.asarray(mask, dtype=bool)
    return {k: np.asarray(v)[mask] for k, v in params_dict.items()}

