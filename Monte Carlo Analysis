    print("\n================= SEPARAÇÃO POR TRACKING =================")
    print(f"Tracking OK (e_ct_max <= {FAIL_THRESHOLD_MAIN:.1f} m): {n_okt}/{n_tot} = {100*n_okt/max(n_tot,1):.1f}%")
    print(f"Tracking FAIL (e_ct_max >  {FAIL_THRESHOLD_MAIN:.1f} m): {n_flt}/{n_tot} = {100*n_flt/max(n_tot,1):.1f}%")

    # percentis por regime
    summarize_percentiles(time_fig8[track_ok],  f"Tempo Figure-8 | tracking OK [s]")
    summarize_percentiles(time_fig8[track_fail], f"Tempo Figure-8 | tracking FAIL [s]")
    summarize_percentiles(emax[track_ok],       f"e_ct_max | tracking OK [m]")
    summarize_percentiles(emax[track_fail],     f"e_ct_max | tracking FAIL [m]")

    # top influências globais (misturado) — útil mas cuidado
