axp.plot(traj_x, traj_y, lw=1.5, alpha=0.7, label='traj')
axp.legend()

pad = 10.0
axp.set_xlim(float(np.min(traj_x) - pad), float(np.max(traj_x) + pad))
axp.set_ylim(float(np.min(traj_y) - pad), float(np.max(traj_y) + pad))

car_length = 2.0
car_width = 1.0

car_patch = patches.Rectangle(
    (-car_length / 2, -car_width / 2),
    car_length,
    car_width,
    linewidth=1.2,
    edgecolor='black',
    facecolor='blue',
    alpha=0.85
)
axp.add_patch(car_patch)

nose_line, = axp.plot([], [], lw=2)


def update(frame):
    """
    Actualiza a posição e orientação do veículo na animação.
    """
    xx = float(traj_x[frame])
    yy = float(traj_y[frame])
    ang = float(yaw_list[frame])

    trans = Affine2D().rotate(ang).translate(xx, yy) + axp.transData
    car_patch.set_transform(trans)

    nx = xx + 1.2 * np.cos(ang)
    ny = yy + 1.2 * np.sin(ang)
    nose_line.set_data([xx, nx], [yy, ny])

    return car_patch, nose_line


stride = 20
frames = range(0, len(traj_x), stride)

ani = animation.FuncAnimation(
    fig,
    update,
    frames=frames,
    interval=5,
    blit=True
)

plt.show()
